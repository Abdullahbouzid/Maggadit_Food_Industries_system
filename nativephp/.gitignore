# Ignore build outputs
android-build.log
ios-build.log
android/app/build/
android/.gradle/
android/gradle/wrapper/gradle-wrapper.jar
ios/build/
ios/Pods/
*.apk
*.aab
*.ipa

# Ignore large bundled files
android/app/src/main/assets/laravel_bundle.zip
ios/laravel/vendor/

# Keep source files
!android/app/src/
!android/gradle/
!android/gradlew*
!android/settings.gradle*
!android/build.gradle*
!ios/*.xcodeproj/
!ios/*.xcworkspace/
!ios/Podfile*
!resources/