<?xml version="1.0" encoding="UTF-8"?>
<!--
  Download the real file from Firebase console > Project settings > Your apps > iOS
  and save it as ios/Runner/GoogleService-Info.plist (add it to the Runner target).
  Alternatively keep using --dart-define values only: AppConfig builds FirebaseOptions
  at runtime, so the native plist is optional for development.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<key>API_KEY</key>
<string>REPLACE_WITH_FIREBASE_API_KEY</string>
<key>GCM_SENDER_ID</key>
<string>000000000000</string>
<key>BUNDLE_ID</key>
<string>com.maggadit.maggaditCustomer</string>
<key>PROJECT_ID</key>
<string>maggaditfoodsystem</string>
<key>STORAGE_BUCKET</key>
<string>maggaditfoodsystem.appspot.com</string>
<key>IS_GCM_ENABLED</key>
<true/>
<key>GOOGLE_APP_ID</key>
<string>1:000000000000:ios:0000000000000000000000</string>
</dict>
</plist>
